meta {
  name: Get a user
  type: http
  seq: 1
}

get {
  url: {{base_url}}/users/:id
  body: none
  auth: none
}

params:path {
  id: 7
}

script:post-response {
  bru.setVar("userName", res.body.name);
}

tests {
  test("is Ada", function () {
    expect(res.getStatus()).to.equal(200);
    expect(bru.getVar("userName")).to.equal("Ada");
  });
}
