meta {
  name: Log in
  type: http
  seq: 1
}

post {
  url: {{base_url}}/login
  body: json
  auth: none
}

body:json {
  {
    "user": "{{user}}",
    "password": "{{password}}"
  }
}

vars:pre-request {
  password: secret
}

vars:post-response {
  token: res.body.token
}

assert {
  res.status: eq 200
  res.body.token: isString
}

tests {
  test("token is for the user", function () {
    expect(res.getBody().token).to.equal("tok-" + bru.getVar("user"));
  });
}
