{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stormix",
  "version": "1.1.1",
  "identifier": "io.github.iruora.stormix",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stormix",
        "width": 1200,
        "height": 780,
        "minWidth": 800,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Stress test APIs and run collection flows.",
    "longDescription": "Load test HTTP APIs and run non-regression flows imported from Postman and Bruno collections, from a desktop app or the stormix CLI.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "MIT OR Apache-2.0",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCQ0E2QTFDMEFBRDQxNjUKUldSbFFhMEtIR3JLYTBuNUsvSFphMU50aGFPTG5xWHJFYVEyZjNIeTA5SU50Tm12c25mWXd0bDcK",
      "endpoints": [
        "https://github.com/Iruora/StormiX/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
